# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

# Server Transport Configuration (Optional)
# =============================================================================
# MCP_TRANSPORT_TYPE: Toggles transport mode. Values: stdio | http | dual.
# Defaults to 'stdio' in development and 'dual' in production/NODE_ENV=production.
# =============================================================================
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true

# HR Assistant Configuration
# =============================================================================
# SMTP Email Configuration (Optional — logs to console if not set)
# Use a Gmail App Password (not your main password). Requires 2FA enabled.
# =============================================================================
# SENDER_EMAIL=your-email@gmail.com
# SENDER_EMAIL_PWD=your-gmail-app-password

# API Key for protecting write operations (Optional — all requests allowed if not set)
# =============================================================================
# MCP_API_KEY=choose-a-strong-secret-key
